# Plantilla del .env para el repo ollama — perfil VPS (copiar a la raíz como .env).
# Solo variables del servicio Ollama; las del chat-hub viven en el repo chathub.

OLLAMA_DOCKERFILE=Dockerfile.ollama.cpu
OLLAMA_GPU=
OLLAMA_NUM_PARALLEL=1

# Límites de recursos en VPS (vacío o 0 = sin límite)
OLLAMA_MEM_LIMIT=1.65g
OLLAMA_CPUS=1.75
