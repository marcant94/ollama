# Plantilla del .env para el repo ollama (copiar a la raíz como .env).
# Solo variables del servicio Ollama; las del chat-hub viven en el repo chathub.

OLLAMA_DOCKERFILE=Dockerfile.ollama.gpu
OLLAMA_GPU=
OLLAMA_NUM_PARALLEL=2

# Límites de recursos (0 o vacío = sin límite)
OLLAMA_MEM_LIMIT=0
OLLAMA_CPUS=0
